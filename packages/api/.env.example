# Neon Postgres connection string (create the project at https://neon.tech)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Long random secret used to sign/verify access tokens (HS256). Generate with e.g.:
#   openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated list of origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:5173

# Base URL of the client app, used to build the emailed /verify-email link
# and the Lemon Squeezy checkout's post-purchase redirect URL
APP_URL=http://localhost:5173

# Resend API key used to send verification emails (create at https://resend.com).
# If unset, verification links are logged to the server console instead of emailed —
# fine for local dev, but registration still succeeds either way.
RESEND_API_KEY=

# "From" address for outgoing emails; must be a verified sender/domain in Resend.
EMAIL_FROM=HVSNA <onboarding@resend.dev>

# Lemon Squeezy (https://app.lemonsqueezy.com/settings/api) — API key,
# the store to checkout against, and the single paid product variant
LEMONSQUEEZY_API_KEY=replace-with-your-lemonsqueezy-api-key
LEMONSQUEEZY_STORE_ID=replace-with-your-store-id
LEMONSQUEEZY_VARIANT_ID=replace-with-your-variant-id

# Signing secret configured on the Lemon Squeezy webhook
# (https://app.lemonsqueezy.com/settings/webhooks), pointed at
# <APP_URL-equivalent-api-host>/webhooks/lemonsqueezy for the
# subscription_* events
LEMONSQUEEZY_WEBHOOK_SECRET=replace-with-your-webhook-signing-secret
