<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for Android 12 (API 31) and higher. See backup_rules.xml for
   the reasoning. Cloud backup (Google account) excludes the app's data;
   device-to-device transfer (cable or local Wi-Fi to the user's new phone, no
   third party) has no section here, so it keeps its default of everything.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="objectbox/" />
        <exclude domain="database" path="task_db" />
        <exclude domain="database" path="task_db-shm" />
        <exclude domain="database" path="task_db-wal" />
    </cloud-backup>
</data-extraction-rules>
