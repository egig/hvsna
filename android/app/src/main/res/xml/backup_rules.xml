<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup rules for Android 11 (API 30) and lower. Android 12+ reads
   data_extraction_rules.xml instead; keep the two files in step.

   The app's data (ObjectBox store, plus the legacy Room `task_db` an old
   install may still have) is excluded so it is never uploaded to the user's
   Google account: the privacy policy promises it stays on the device, and it
   holds religious-practice records (qadha fasts). Users move data between
   phones with Settings > Backup & Restore. Small preferences (theme, language,
   reminders toggle) are still backed up.
-->
<full-backup-content>
    <exclude domain="file" path="objectbox/" />
    <exclude domain="database" path="task_db" />
    <exclude domain="database" path="task_db-shm" />
    <exclude domain="database" path="task_db-wal" />
</full-backup-content>
