#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Run unit tests in every workspace that defines a "test" script
# (exclude e2e tests; website has no test suite so it's skipped automatically)
echo "Running unit tests before commit..."
npm run test --workspaces --if-present

# Check if tests passed
if [ $? -eq 0 ]; then
    echo "Unit tests passed! Proceeding with commit."
else
    echo "Unit tests failed. Commit aborted."
    exit 1
fi
