# Environment configuration for feature flags
# Copy this file to .env.local and customize as needed

# Environment mode (development, staging, production)
# This determines which feature flag configuration to use
MODE=development

# You can also override specific feature flags here if needed
# VITE_NEW_DASHBOARD=true
# VITE_BETA_SEARCH=false
# VITE_API_URL=http://localhost:3000
# VITE_CLERK_PUBLISHABLE_KEY=
